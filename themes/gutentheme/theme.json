{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
        "appearanceTools": true,
        "useRootPaddingAwareAlignments": true,
        "blocks": {
            "core/button": {
                "spacing": {
                    "spacingSizes": [
                        { "name": "xSmall", "size": "10px", "slug": "x-small" },
                        { "name": "Small", "size": "15px", "slug": "small" },
                        { "name": "Medium", "size": "20px", "slug": "medium" },
                        { "name": "Large", "size": "30px", "slug": "large" },
                        { "name": "xLarge", "size": "40px", "slug": "x-large" }
                    ]
                }
            }
        },
        "border": {
            "radiusSizes": [
                { "name": "xSmall", "size": "4px", "slug": "x-small" },
                { "name": "Small", "size": "8px", "slug": "small" },
                { "name": "Medium", "size": "12px", "slug": "medium" },
                { "name": "Large", "size": "20px", "slug": "large" },
                { "name": "xLarge", "size": "40px", "slug": "x-large" }
            ]
        },
        "color": {
            "defaultDuotone": false,
            "defaultGradients": false,
            "defaultPalette": false,
            "duotone": [
                { "colors": [ "#000000", "#ffffff" ], "name": "Black and White", "slug": "black-and-white" },
                { "colors": [ "#440099", "#ffffff" ], "name": "Primary and White", "slug": "primary-and-white" }
            ],
            "gradients": [
                {
                    "gradient": "linear-gradient(var(--wp--preset--color--base) 50%, var(--wp--preset--color--contrast) 50%)",
                    "name": "Base to Contrast",
                    "slug": "base-contrast"
                },
                {
                    "gradient": "linear-gradient(var(--wp--preset--color--contrast) 50%, var(--wp--preset--color--base) 50%)",
                    "name": "Contrast to Base",
                    "slug": "contrast-base"
                }
            ],
            "palette": [
                { "color": "#ffffff", "name": "Base", "slug": "base" },
                { "color": "#000000", "name": "Contrast", "slug": "contrast" },
                { "color": "#440099", "name": "Primary", "slug": "primary" },
                { "color": "#F0F0F0", "name": "Tertiary", "slug": "tertiary" }
            ]
        },
        "custom": {
            "lineHeight": {
                "x-small": 1.1,
                "small": 1.25,
                "medium": 1.5,
                "large": 1.75,
                "x-large": 2
            }
        },
        "layout": {
            "contentSize": "640px",
            "wideSize": "1280px"
        },
        "shadow": {
            "defaultPresets": false,
            "presets": [
                { "name": "Light", "shadow": "0 0 5px rgba(0, 0, 0, 0.1)", "slug": "light" },
                { "name": "Natural", "shadow": "5px 5px 10px rgba(0, 0, 0, 0.2)", "slug": "natural" },
                { "name": "Deep", "shadow": "0 0 40px rgba(0, 0, 0, 0.2)", "slug": "deep" },
                { "name": "Solid", "shadow": "5px 5px 0 currentColor", "slug": "solid" }
            ]
        },
        "spacing": {
            "defaultSpacingSizes": false,
            "spacingScale": {
                "steps": 0
            },
            "spacingSizes": [
                { "name": "XS", "size": "clamp(1.5rem, 5vw, 2rem)", "slug": "30" },
                { "name": "S", "size": "clamp(1.8rem, 1.8rem + ((1vw - 0.48rem) * 2.885), 3rem)", "slug": "40" },
                { "name": "M", "size": "clamp(2.5rem, 8vw, 4.5rem)", "slug": "50" },
                { "name": "L", "size": "clamp(3.75rem, 10vw, 7rem)", "slug": "60" },
                { "name": "XL", "size": "clamp(5rem, 5.25rem + ((1vw - 0.48rem) * 9.096), 8rem)", "slug": "70" },
                { "name": "XXL", "size": "clamp(7rem, 14vw, 11rem)", "slug": "80" }
            ],
            "units": ["%", "px", "em", "rem", "vh", "vw"]
        },
        "typography": {
            "defaultFontSizes": false,
            "dropCap": false,
            "fluid": {
                "maxViewportWidth": "1280px",
                "minViewportWidth": "780px"
            },
            "fontFamilies": [
                {
                    "fontFace": [
                        {
                            "fontDisplay": "block",
                            "fontFamily": "Google Sans",
                            "fontStyle": "normal",
                            "fontWeight": "100 1000",
                            "src": [ "file:./assets/fonts/google-sans/google-sans.woff2" ]
                        },
                        {
                            "fontDisplay": "block",
                            "fontFamily": "Google Sans",
                            "fontStyle": "italic",
                            "fontWeight": "100 1000",
                            "src": [ "file:./assets/fonts/google-sans/google-sans.woff2" ]
                        }
                    ],
                    "fontFamily": "Google Sans, sans-serif",
                    "name": "Google Sans",
                    "slug": "google-sans"
                },
                {
                    "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Helvetica Neue', sans-serif",
                    "name": "System Font",
                    "slug": "system-font"
                },
                {
                    "fontFace": [
                        {
                            "fontFamily": "Sora",
                            "fontStyle": "normal",
                            "fontWeight": "100 800",
                            "src": [ "file:./assets/fonts/sora/Sora-VariableFont_wght.ttf" ]
                        }
                    ],
                    "fontFamily": "Sora, sans-serif",
                    "name": "Sora",
                    "slug": "sora"
                },
                {
                    "fontFace": [
                        {
                            "fontFamily": "Geist",
                            "fontStyle": "normal",
                            "fontWeight": "100 900",
                            "src": [ "file:./assets/fonts/geist/Geist-VariableFont_wght.ttf" ]
                        }
                    ],
                    "fontFamily": "Geist, sans-serif",
                    "name": "Geist",
                    "slug": "geist"
                },
                {
                    "fontFace": [
                        {
                            "fontFamily": "Playfair Display",
                            "fontStyle": "normal",
                            "fontWeight": "400 900",
                            "src": [ "file:./assets/fonts/playfair-display/PlayfairDisplay-VariableFont_wght.ttf" ]
                        }
                    ],
                    "fontFamily": "'Playfair Display', serif",
                    "name": "Playfair Display",
                    "slug": "playfair"
                },
                {
                    "fontFace": [
                        {
                            "fontFamily": "Montserrat",
                            "fontStyle": "normal",
                            "fontWeight": "100 900",
                            "src": [ "file:./assets/fonts/montserrat/Montserrat-VariableFont_wght.ttf" ]
                        }
                    ],
                    "fontFamily": "Montserrat, sans-serif",
                    "name": "Montserrat",
                    "slug": "montserrat"
                },
                {
                    "fontFace": [
                        {
                            "fontFamily": "Merriweather",
                            "fontStyle": "normal",
                            "fontWeight": "300 900",
                            "src": [ "file:./assets/fonts/merriweather/Merriweather-VariableFont_wght.ttf" ]
                        }
                    ],
                    "fontFamily": "Merriweather, serif",
                    "name": "Merriweather",
                    "slug": "merriweather"
                },
                {
                    "fontFace": [
                        {
                            "fontFamily": "Space Grotesk",
                            "fontStyle": "normal",
                            "fontWeight": "300 700",
                            "src": [ "file:./assets/fonts/space-grotesk/SpaceGrotesk-VariableFont_wght.ttf" ]
                        }
                    ],
                    "fontFamily": "'Space Grotesk', sans-serif",
                    "name": "Space Grotesk",
                    "slug": "space-grotesk"
                },
                {
                    "fontFace": [
                        {
                            "fontFamily": "Crimson Pro",
                            "fontStyle": "normal",
                            "fontWeight": "200 900",
                            "src": [ "file:./assets/fonts/crimson-pro/CrimsonPro-VariableFont_wght.ttf" ]
                        }
                    ],
                    "fontFamily": "'Crimson Pro', serif",
                    "name": "Crimson Pro",
                    "slug": "crimson-pro"
                },
                {
                    "fontFace": [
                        {
                            "fontFamily": "Libre Caslon Display",
                            "fontStyle": "normal",
                            "fontWeight": "400",
                            "src": [ "file:./assets/fonts/libre-caslon-display/LibreCaslonDisplay-Regular.ttf" ]
                        }
                    ],
                    "fontFamily": "'Libre Caslon Display', serif",
                    "name": "Libre Caslon Display",
                    "slug": "libre-caslon-display"
                },
                {
                    "fontFace": [
                        {
                            "fontFamily": "Inter",
                            "fontStyle": "normal",
                            "fontWeight": "100 900",
                            "src": [ "file:./assets/fonts/inter/Inter[opsz,wght].ttf" ]
                        }
                    ],
                    "fontFamily": "Inter, sans-serif",
                    "name": "Inter",
                    "slug": "inter"
                },
                {
                    "fontFace": [
                        {
                            "fontFamily": "Urbanist",
                            "fontStyle": "normal",
                            "fontWeight": "100 900",
                            "src": [ "file:./assets/fonts/urbanist/Urbanist[wght].ttf" ]
                        }
                    ],
                    "fontFamily": "Urbanist, sans-serif",
                    "name": "Urbanist",
                    "slug": "urbanist"
                },
                {
                    "fontFace": [
                        {
                            "fontFamily": "Open Sans",
                            "fontStyle": "normal",
                            "fontWeight": "300 800",
                            "src": [ "file:./assets/fonts/open-sans/OpenSans[wdth,wght].ttf" ]
                        }
                    ],
                    "fontFamily": "'Open Sans', sans-serif",
                    "name": "Open Sans",
                    "slug": "open-sans"
                },
                {
                    "fontFace": [
                        {
                            "fontFamily": "Bricolage Grotesque",
                            "fontStyle": "normal",
                            "fontWeight": "200 800",
                            "src": [ "file:./assets/fonts/bricolage-grotesque/BricolageGrotesque[opsz,wdth,wght].ttf" ]
                        }
                    ],
                    "fontFamily": "'Bricolage Grotesque', sans-serif",
                    "name": "Bricolage Grotesque",
                    "slug": "bricolage"
                },
                {
                    "fontFace": [
                        {
                            "fontFamily": "Mulish",
                            "fontStyle": "normal",
                            "fontWeight": "200 1000",
                            "src": [ "file:./assets/fonts/mulish/Mulish[wght].ttf" ]
                        }
                    ],
                    "fontFamily": "Mulish, sans-serif",
                    "name": "Mulish",
                    "slug": "mulish"
                },
                {
                    "fontFace": [
                        {
                            "fontFamily": "Poppins",
                            "fontStyle": "normal",
                            "fontWeight": "400",
                            "src": [ "file:./assets/fonts/poppins/Poppins-Regular.ttf" ]
                        },
                        {
                            "fontFamily": "Poppins",
                            "fontStyle": "normal",
                            "fontWeight": "700",
                            "src": [ "file:./assets/fonts/poppins/Poppins-Bold.ttf" ]
                        }
                    ],
                    "fontFamily": "Poppins, sans-serif",
                    "name": "Poppins",
                    "slug": "poppins"
                },
                {
                    "fontFace": [
                        {
                            "fontFamily": "Bodoni Moda",
                            "fontStyle": "normal",
                            "fontWeight": "400 900",
                            "src": [ "file:./assets/fonts/bodoni-moda/BodoniModa[opsz,wght].ttf" ]
                        }
                    ],
                    "fontFamily": "'Bodoni Moda', serif",
                    "name": "Bodoni Moda",
                    "slug": "bodoni"
                },
                {
                    "fontFace": [
                        {
                            "fontFamily": "EB Garamond",
                            "fontStyle": "normal",
                            "fontWeight": "400 800",
                            "src": [ "file:./assets/fonts/eb-garamond/EBGaramond[wght].ttf" ]
                        }
                    ],
                    "fontFamily": "'EB Garamond', serif",
                    "name": "EB Garamond",
                    "slug": "eb-garamond"
                },
                {
                    "fontFace": [
                        {
                            "fontFamily": "Fraunces",
                            "fontStyle": "normal",
                            "fontWeight": "100 900",
                            "src": [ "file:./assets/fonts/fraunces/Fraunces[SOFT,WONK,opsz,wght].ttf" ]
                        }
                    ],
                    "fontFamily": "Fraunces, serif",
                    "name": "Fraunces",
                    "slug": "fraunces"
                },
                {
                    "fontFace": [
                        {
                            "fontFamily": "Cormorant Garamond",
                            "fontStyle": "normal",
                            "fontWeight": "300 700",
                            "src": [ "file:./assets/fonts/cormorant-garamond/CormorantGaramond[wght].ttf" ]
                        }
                    ],
                    "fontFamily": "'Cormorant Garamond', serif",
                    "name": "Cormorant Garamond",
                    "slug": "cormorant"
                }
            ],
            "fontSizes": [
                { "fluid": false, "name": "xxxSmall", "size": "12px", "slug": "xxx-small" },
                { "fluid": false, "name": "xxSmall", "size": "14px", "slug": "xx-small" },
                { "fluid": false, "name": "xSmall", "size": "16px", "slug": "x-small" },
                { "fluid": false, "name": "Small", "size": "18px", "slug": "small" },
                { "fluid": { "min": "18px", "max": "20px" }, "name": "Medium", "size": "20px", "slug": "medium" },
                { "fluid": { "min": "20px", "max": "24px" }, "name": "Large", "size": "24px", "slug": "large" },
                { "fluid": { "min": "24px", "max": "30px" }, "name": "xLarge", "size": "30px", "slug": "x-large" },
                { "fluid": { "min": "30px", "max": "36px" }, "name": "xxLarge", "size": "36px", "slug": "xx-large" },
                { "fluid": { "min": "36px", "max": "48px" }, "name": "xxxLarge", "size": "48px", "slug": "xxx-large" }
            ]
        }
    },
    "styles": {
        "blocks": {
            "core/button": {
                "variations": {
                    "outline": {
                        "border": { "color": "currentColor", "style": "solid", "width": "1px" },
                        "spacing": {
                            "padding": { "top": "14px", "right": "29px", "bottom": "14px", "left": "29px" }
                        }
                    }
                }
            },
            "core/buttons": {
                "spacing": { "blockGap": "10px" }
            },
            "core/code": {
                "color": {
                    "background": "var(--wp--preset--color--contrast)",
                    "text": "var(--wp--preset--color--base)"
                },
                "css": "& code {overflow-x: scroll; tab-size: 4; white-space: pre !important;}",
                "spacing": {
                    "padding": {
                        "top": "var(--wp--preset--spacing--40)",
                        "right": "var(--wp--preset--spacing--40)",
                        "bottom": "var(--wp--preset--spacing--40)",
                        "left": "var(--wp--preset--spacing--40)"
                    }
                },
                "typography": { "fontSize": "var(--wp--preset--font-size--x-small)" }
            },
            "core/cover": {
                "spacing": {
                    "padding": {
                        "top": "var(--wp--preset--spacing--40)",
                        "right": "var(--wp--preset--spacing--40)",
                        "bottom": "var(--wp--preset--spacing--40)",
                        "left": "var(--wp--preset--spacing--40)"
                    }
                }
            },
            "core/heading": {
                "variations": {
                    "balanced": { "css": "&.is-style-balanced { text-wrap: balance; }" },
                    "eyebrow": {
                        "typography": {
                            "fontSize": "var(--wp--preset--font-size--xxx-small)",
                            "fontWeight": "500",
                            "letterSpacing": "0.05em",
                            "lineHeight": "var(--wp--custom--line-height--medium)",
                            "textTransform": "uppercase"
                        }
                    }
                }
            },
            "core/image": {
                "variations": {
                    "zoom": {
                        "css": "&.is-style-zoom { overflow: hidden; } &.is-style-zoom img { transition: transform var(--gt-motion-slow) var(--gt-motion-ease); } &.is-style-zoom:hover img { transform: scale(var(--gt-motion-scale)); }"
                    }
                }
            },
            "core/list": {
                "spacing": {
                    "padding": { "left": "var(--wp--preset--spacing--30)" }
                },
                "variations": {
                    "no-style": { "css": "&.is-style-no-style { list-style-type: none; padding-left: 0; }" }
                }
            },
            "core/navigation": {
                "css": "& .wp-block-navigation__responsive-container-open, .wp-block-navigation__responsive-container-close {border: 1px solid currentColor; padding: 2px;}",
                "spacing": { "blockGap": "var(--wp--preset--spacing--30)" },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--xx-small)",
                    "lineHeight": "var(--wp--custom--line-height--medium)"
                }
            },
            "core/navigation-submenu": {
                "border": { "color": "currentColor !important" }
            },
            "core/paragraph": {
                "variations": {
                    "balanced": { "css": "&.is-style-balanced { text-wrap: balance; }" },
                    "eyebrow": {
                        "typography": {
                            "fontSize": "var(--wp--preset--font-size--xxx-small)",
                            "fontWeight": "500",
                            "letterSpacing": "0.05em",
                            "lineHeight": "var(--wp--custom--line-height--medium)",
                            "textTransform": "uppercase"
                        }
                    },
                    "indent": { "css": "&.is-style-indent { text-indent: var(--wp--preset--spacing--30); }" }
                }
            },
            "core/post-comments-form": {
                "css": " & .form-submit {margin-bottom: 0;}"
            },
            "core/post-featured-image": {
                "variations": {
                    "zoom": {
                        "css": "&.is-style-zoom { overflow: hidden; } &.is-style-zoom img { transition: transform var(--gt-motion-slow) var(--gt-motion-ease); } &.is-style-zoom:hover img { transform: scale(var(--gt-motion-scale)); }"
                    }
                }
            },
            "core/post-template": {
                "spacing": { "blockGap": "var(--wp--preset--spacing--60)" }
            },
            "core/post-title": {
                "elements": {
                    "link": {
                        "color": { "text": "var(--wp--preset--color--contrast)" },
                        ":hover": { "color": { "text": "var(--wp--preset--color--primary)" } }
                    }
                },
                "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" }
            },
            "core/preformatted": {
                "color": {
                    "background": "var(--wp--preset--color--contrast)",
                    "text": "var(--wp--preset--color--base)"
                },
                "css": "{overflow-x: scroll; tab-size: 4; white-space: pre !important;}",
                "spacing": {
                    "padding": {
                        "top": "var(--wp--preset--spacing--40)",
                        "right": "var(--wp--preset--spacing--40)",
                        "bottom": "var(--wp--preset--spacing--40)",
                        "left": "var(--wp--preset--spacing--40)"
                    }
                },
                "typography": { "fontSize": "var(--wp--preset--font-size--x-small)" }
            },
            "core/query-pagination": {
                "css": "margin-top: var(--wp--preset--spacing--30) !important;"
            },
            "core/query-title": {
                "typography": { "fontSize": "var(--wp--preset--font-size--large)" }
            },
            "core/quote": {
                "border": { "color": "currentColor", "style": "solid", "width": "1px" },
                "css": "& p {margin: 0;}",
                "elements": {
                    "cite": {
                        "spacing": { "margin": { "top": "10px" } },
                        "typography": {
                            "fontSize": "var(--wp--preset--font-size--x-small)",
                            "fontStyle": "inherit"
                        }
                    }
                },
                "spacing": {
                    "padding": {
                        "top": "var(--wp--preset--spacing--40)",
                        "right": "var(--wp--preset--spacing--40)",
                        "bottom": "var(--wp--preset--spacing--40)",
                        "left": "var(--wp--preset--spacing--40)"
                    }
                }
            },
            "core/search": {
                "css": "& .wp-block-search__input, .wp-element-button {padding: 10px 20px;} & .wp-block-search__input {border-color: var(--wp--preset--color--contrast);}"
            },
            "core/separator": {
                "border": { "color": "currentColor", "radius": "0", "style": "solid", "width": "1px 0 0" },
                "css": ":not(.is-style-wide):not(.is-style-dots) { width: 80px; }",
                "variations": {
                    "extended": { "css": "&.is-style-extended { width: 180px; }" }
                }
            },
            "core/site-title": {
                "elements": {
                    "link": {
                        "color": { "text": "var(--wp--preset--color--contrast)" },
                        "typography": { "textDecoration": "none" }
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--medium)",
                    "fontWeight": "500",
                    "lineHeight": "var(--wp--custom--line-height--x-small)"
                }
            },
            "core/social-links": {
                "spacing": { "blockGap": "10px" },
                "variations": {
                    "outline": {
                        "css": "& li.wp-block-social-link { background-color: transparent; border: 1px solid currentColor; color: currentColor; }"
                    }
                }
            },
            "core/table": {
                "typography": { "fontSize": "var(--wp--preset--font-size--small)" }
            },
            "core/template-part": {
                "spacing": { "margin": { "top": "0 !important" } }
            }
        },
        "color": {
            "background": "var(--wp--preset--color--base)",
            "text": "var(--wp--preset--color--contrast)"
        },
        "css": "html {-moz-osx-font-smoothing: grayscale; -webkit-font-smoothing: antialiased;} ::selection {background-color: var(--wp--preset--color--primary); color: var(--wp--preset--color--base);} .wp-element-button:visited, .wp-block-button__link:visited { color: currentColor !important; }",
        "elements": {
            "button": {
                "border": { "radius": "0" },
                "color": {
                    "background": "var(--wp--preset--color--primary)",
                    "text": "var(--wp--preset--color--base)"
                },
                "css": "{width: auto;}",
                "spacing": {
                    "padding": { "top": "15px", "right": "30px", "bottom": "15px", "left": "30px" }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--xx-small)",
                    "fontWeight": "500",
                    "lineHeight": "var(--wp--custom--line-height--medium)"
                },
                ":focus": {
                    "outline": { "color": "var(--wp--preset--color--primary)", "offset": "1px", "style": "solid", "width": "2px" }
                }
            },
            "caption": {
                "spacing": { "margin": { "top": "10px", "bottom": "0" } },
                "typography": { "fontSize": "var(--wp--preset--font-size--x-small)" }
            },
            "heading": {
                "typography": {
                    "fontWeight": "500",
                    "lineHeight": "var(--wp--custom--line-height--x-small)"
                }
            },
            "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
            "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
            "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)" } },
            "h4": { "typography": { "fontSize": "var(--wp--preset--font-size--small)" } },
            "h5": { "typography": { "fontSize": "var(--wp--preset--font-size--x-small)" } },
            "h6": { "typography": { "fontSize": "var(--wp--preset--font-size--x-small)" } },
            "link": {
                "color": { "text": "var(--wp--preset--color--primary)" },
                "typography": { "textDecoration": "underline" },
                ":hover": { "color": { "text": "var(--wp--preset--color--contrast)" } },
                ":focus": {
                    "outline": { "color": "currentColor", "offset": "1px", "style": "solid", "width": "1px" }
                },
                "css": "a, a:not(.wp-element-button) {text-decoration-thickness: 1px; text-underline-offset: 2px;}"
            },
            "select": {
                "spacing": {
                    "padding": { "top": "5px", "right": "10px", "bottom": "5px", "left": "10px" }
                }
            },
            "textInput": {
                "border": { "color": "currentColor", "radius": "0", "style": "solid", "width": "1px" },
                "color": { "background": "transparent", "text": "inherit" },
                "spacing": {
                    "padding": { "top": "10px", "right": "15px", "bottom": "10px", "left": "15px" }
                }
            }
        },
        "spacing": {
            "blockGap": "var(--wp--preset--spacing--30)",
            "padding": {
                "top": "0",
                "right": "var(--wp--preset--spacing--30)",
                "bottom": "0",
                "left": "var(--wp--preset--spacing--30)"
            }
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--google-sans)",
            "fontSize": "var(--wp--preset--font-size--small)",
            "fontWeight": "400",
            "letterSpacing": "0.01em",
            "lineHeight": "var(--wp--custom--line-height--large)"
        }
    }
}
